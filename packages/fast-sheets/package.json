{
  "name": "fast-sheets",
  "version": "2.0.0-beta.1",
  "description": "Blazing-fast spreadsheet rendering engine",
  "main": "./dist/fast-sheets-core.cjs",
  "module": "./dist/fast-sheets-core.es.js",
  "types": "./dist/lib/core/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/fast-sheets-core.es.js",
      "require": "./dist/fast-sheets-core.cjs"
    },
    "./editable": {
      "types": "./dist/lib/plugins/editable/index.d.ts",
      "import": "./dist/fast-sheets-editable.es.js",
      "require": "./dist/fast-sheets-editable.cjs"
    },
    "./search": {
      "types": "./dist/lib/plugins/search/index.d.ts",
      "import": "./dist/fast-sheets-search.es.js",
      "require": "./dist/fast-sheets-search.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "types:check": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "fast-sheets",
    "fastsheets",
    "spreadsheets",
    "grid",
    "tables",
    "canvas"
  ],
  "author": "Dmitry Savchenkov <topratecoder@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fast-sheets/fast-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/fast-sheets/fast-sheets/issues"
  },
  "homepage": "https://fastsheets.io",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "jsdom": "^30.1.2",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
