{
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "author": "Dmitry Savchenkov <topratecoder@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:lib": "pnpm --filter fast-sheets run dev",
    "dev:react-demo": "pnpm run dev:lib & pnpm --filter react-demo run dev",
    "dev:vanilla-js-demo": "pnpm run dev:lib & pnpm --filter vanilla-js-demo run dev",
    "dev:vanilla-ts-demo": "pnpm run dev:lib & pnpm --filter vanilla-ts-demo run dev",
    "dev:vue-demo": "pnpm run dev:lib & pnpm --filter vue-demo run dev",
    "build:lib": "pnpm --filter fast-sheets run build",
    "build:demo": "pnpm --filter='./apps/**' --parallel run build",
    "build": "pnpm run build:lib && pnpm run build:demo",
    "lint:lib": "eslint --ext ts ./packages/*/lib",
    "lint:demo": "pnpm -r --filter='./apps/**' --parallel run lint",
    "lint": "pnpm run lint:lib & pnpm run lint:demo",
    "prettier:lib": "prettier --log-level error --write ./packages/*/lib",
    "prettier:demo": "pnpm -r --filter='./apps/**' --parallel run prettier",
    "types:check": "pnpm -r --filter='./packages/**' --parallel run types:check"
  },
  "lint-staged": {
    "apps/**/*.{js,ts,tsx,vue}": [
      "pnpm lint:demo",
      "pnpm prettier:demo"
    ],
    "packages/**/*.{js,ts,tsx}": [
      "pnpm lint:lib",
      "pnpm prettier:lib"
    ]
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.0"
  }
}
